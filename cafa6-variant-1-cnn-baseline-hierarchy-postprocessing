    "            all_terms.add(cur)\n",
    "            continue\n",
    "        m = IS_A_RE.match(line)\n",
    "        if m and cur:\n",
    "            parents[cur].append(m.group(1))\n",
    "\n",
    "print(\"terms in obo:\", len(all_terms), \"| edges:\", sum(len(v) for v in parents.values()))"
